# Google Gemini API Key (get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=bharat_legal_knowledge

# Retrieval Configuration
TOP_K=5
# Distance threshold (cosine distance: 0.0 is identical, higher is further; distance <= RETRIEVAL_THRESHOLD is kept)
RETRIEVAL_THRESHOLD=0.8

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Optional: Set to 'production' for deployment
ENVIRONMENT=development
